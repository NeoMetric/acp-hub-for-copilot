{
	"name": "acp-hub-for-copilot",
	"displayName": "ACP Hub for Copilot",
	"description": "Use Claude, Codex and Google ACP agents in GitHub Copilot Chat, with one sidebar to install, sign in, configure and monitor them.",
	"version": "0.0.1",
	"publisher": "NeoMetric",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/NeoMetric/acp-hub-for-copilot.git"
	},
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"activationEvents": [
		"onStartupFinished",
		"onLanguageModelChatProvider:acphub-claude",
		"onLanguageModelChatProvider:acphub-codex",
		"onLanguageModelChatProvider:acphub-google"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "acphub-claude",
				"displayName": "Claude Agent"
			},
			{
				"vendor": "acphub-codex",
				"displayName": "Codex Agent"
			},
			{
				"vendor": "acphub-google",
				"displayName": "Google Agent"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "npm run typecheck && node esbuild.js",
		"typecheck": "tsc -p . --noEmit",
		"watch": "node esbuild.js --watch",
		"lint": "eslint .",
		"test": "vitest run",
		"test:smoke": "npm run compile && node esbuild.js --tests && vscode-test",
		"package": "vsce package"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.0",
		"@types/vscode": "^1.105.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"mocha": "^12.0.3",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
