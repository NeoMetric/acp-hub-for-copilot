{
	"name": "acp-hub-for-copilot",
	"displayName": "ACP Hub for Copilot",
	"description": "Use Claude, Codex and Antigravity ACP agents in GitHub Copilot Chat, with one sidebar to install, sign in, configure and monitor them.",
	"version": "0.0.6",
	"publisher": "NeoMetric",
	"license": "MIT",
	"icon": "media/icon.png",
	"homepage": "https://github.com/NeoMetric/acp-hub-for-copilot#readme",
	"bugs": {
		"url": "https://github.com/NeoMetric/acp-hub-for-copilot/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/NeoMetric/acp-hub-for-copilot.git"
	},
	"galleryBanner": {
		"color": "#1b1b1e",
		"theme": "dark"
	},
	"keywords": [
		"acp",
		"agent client protocol",
		"copilot",
		"chat",
		"claude",
		"codex",
		"antigravity",
		"gemini",
		"ai agent",
		"language model"
	],
	"engines": {
		"vscode": "^1.105.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Agent Hub runs agent processes and requires a trusted workspace."
		}
	},
	"categories": [
		"AI",
		"Chat"
	],
	"activationEvents": [
		"onStartupFinished",
		"onLanguageModelChatProvider:Claude Agent",
		"onLanguageModelChatProvider:Codex Agent",
		"onLanguageModelChatProvider:Google Agent"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "acpHub.showLogs",
				"title": "ACP Hub: Show Logs"
			},
			{
				"command": "acpHub.signIn",
				"title": "ACP Hub: Sign In"
			},
			{
				"command": "acpHub.install",
				"title": "ACP Hub: Install Agent"
			},
			{
				"command": "acpHub.refreshUsage",
				"title": "ACP Hub: Refresh Usage"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "acpHub",
					"title": "ACP Hub",
					"icon": "media/acp-hub.svg"
				}
			]
		},
		"views": {
			"acpHub": [
				{
					"id": "acpHub.agents",
					"type": "webview",
					"name": "Agents"
				}
			]
		},
		"languageModelChatProviders": [
			{
				"vendor": "Claude Agent",
				"displayName": "Claude Agent"
			},
			{
				"vendor": "Codex Agent",
				"displayName": "Codex Agent"
			},
			{
				"vendor": "Google Agent",
				"displayName": "Google Agent"
			}
		],
		"configuration": {
			"title": "ACP Hub",
			"properties": {
				"acpHub.server.port": {
					"description": "The port the ACP Hub server answers on, on `127.0.0.1`. Every window of this machine uses the same port and so shares one server; change it when another program holds the default.",
					"default": 8791,
					"type": "number"
				},
				"acpHub.server.autoStart": {
					"description": "Start the ACP Hub server when no server answers on the port. Turn it off to run the server yourself, with `npm run server`.",
					"default": true,
					"type": "boolean"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"vscode:uninstall": "node ./dist/uninstall.js",
		"compile": "npm run typecheck && node esbuild.js",
		"typecheck": "tsc -p . --noEmit",
		"watch": "node esbuild.js --watch",
		"server": "node dist/server.js",
		"lint": "eslint .",
		"test": "vitest run",
		"test:smoke": "npm run compile && node esbuild.js --tests && vscode-test",
		"package": "vsce package",
		"generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-vendors.mts",
		"generate:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-vendors.mts --check"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.0",
		"@types/vscode": "^1.105.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"mocha": "^12.0.3",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
